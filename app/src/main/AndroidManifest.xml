<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".SkeletonApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- singleTop: a deep link to a running app arrives in onNewIntent instead of a new Activity.
             No <nav-graph> element here on purpose: it would generate intent filters from <deepLink>
             entries of nav_graph.xml and let NavController open links bypassing the resolver. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Keep in sync with DEEP_LINK_ORIGINS (app/deeplink/DeepLinkConfig.kt). -->
            <!-- TODO: add android:autoVerify="true" once the domain hosts assetlinks.json. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="kompas.example.com" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kompas" />
            </intent-filter>
        </activity>

        <!-- Legacy login screen. Not exported: reachable only from inside the app. -->
        <activity
            android:name=".legacy.LoginActivity"
            android:exported="false" />
    </application>

</manifest>
